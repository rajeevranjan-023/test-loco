# Copy to .env — names only, never commit real values.
MONGODB_URI=mongodb://127.0.0.1:27017/loco
JWT_SECRET=change-me
CLIENT_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
OTP_DEV_FIXED=true            # dev only; the server refuses to boot with this in production

# Dev seed data at server start is OPT-IN and is ignored in production (NODE_ENV=production / RENDER / VERCEL).
# Leave unset/false for an empty database; run `npm run seed:demo | seed:study | seed:service` explicitly instead.
AUTO_SEED=false
